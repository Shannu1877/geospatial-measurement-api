# Geospatial File Measurement API - Environment Configuration

# Application Metadata
APP_NAME=Geospatial Measurement API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Database Connection (SQLite default, can be PostgreSQL in production)
DATABASE_URL=sqlite:///./geospatial.db

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Geospatial Precision (Decimal places for metric rounding)
MEASUREMENT_PRECISION=2
